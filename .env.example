# Copy to .env and fill in. Nothing here is secret: CloudLens signs in as a public
# client with PKCE and reads Azure with a managed identity, so there is no client
# secret to store. `.env` itself is gitignored regardless.
#
# Only PROJECT_ENDPOINT is required. Everything else has a working default.

# ---------------------------------------------------------------- AI (required)
# The Foundry project the agent talks to. The app refuses to start without it.
# infra/deploy.ps1 prints this value when it finishes.
PROJECT_ENDPOINT=https://<account>.cognitiveservices.azure.com/api/projects/<project>
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# ---------------------------------------------------------------- sign-in
# Leave AUTH_CLIENT_ID unset to run with a local password instead of Entra; the
# generated password is printed once into the log on first start.
#AUTH_CLIENT_ID=<app registration client id>
#AUTH_TENANT_ID=<tenant id, or "organizations" for any work account>
#AUTH_REDIRECT_URI=http://localhost:8100/auth/callback
#AUTH_ADMINS=you@example.com

# Each person sees the subscriptions their own Azure access allows. Needs a one-time
# tenant admin consent for ARM user_impersonation; set to false if that is refused,
# and the app falls back to what its own identity can read.
#AUTH_DELEGATED_ARM=true

# ---------------------------------------------------------------- warehouse
# The warehouse is Azure Database for PostgreSQL Flexible Server, and nothing else.
# PGHOST is required: the app refuses to start without it rather than quietly
# falling back to something local, because there is no correct guess for where a
# customer's cost data lives.
#
# No password. The app authenticates with its managed identity, or with your
# az login locally. Set PGPASSWORD only for a server that has password auth on.
#PGHOST=<server>.postgres.database.azure.com
#PGDATABASE=cloudlens
#PGUSER=<managed identity name>
#PGSSLMODE=require

# Set true only when this instance uses PostgreSQL demo costs. Azure budget reads and
# writes are disabled; demo budgets are not fabricated.
CLOUDLENS_DEMO_MODE=false

# An optional schema to hold the warehouse, instead of `public`. Lets one server
# carry more than one environment without either overwriting the other.
#PGSCHEMA=cloudlens

# How much memory one sort or hash node may use before it spills to disk. Unset means
# the server's own value, which is the right answer unless you have measured otherwise.
#
# Charged PER NODE, not per query or per connection: a query with three sorts can take
# three times this, and up to PG_POOL_SIZE connections can be doing that at once. Size it
# against the server's memory, not against one query.
#
# Worth setting where the dashboard reads a large derived table. On a 2.78M-row
# resource_presence the top-resources query sorts about 508,000 groups and needs roughly
# 90MB; below that it spills to temp files and pays for it on every request.
#PG_WORK_MEM=128MB

# How long a dashboard read may run on the server before PostgreSQL cancels it.
#
# Set this. An application timeout cannot stop a database query: the await is
# cancelled, but the worker thread, the pooled connection and the query itself keep
# going, and the pool slot is never returned. Once enough slots leak that way every
# request fails on a busy pool, which looks like an outage and is really a leak.
#
# Keep it below the caller's own timeout. Dashboard browser requests give up after 30s,
# so the customer deployment defaults to 25s; increase only after measuring the route.
# Applied to readers only; the rollup and presence rebuilds run for several minutes
# and are not subject to it. A bare number is milliseconds.
#PG_STATEMENT_TIMEOUT=25s

# Optional exact-key covering indexes for Executive counts and non-compact Billing.
# Default off. Enabling builds indexes on existing summaries at startup and on
# subsequent staged rebuilds; budget disk/headroom and use a controlled maintenance
# startup first. No raw-data rewrite, new financial grain or full rebuild is needed.
# Readers certify index version/shape/validity and pin published views during their
# burst; missing/stale/unsupported sources keep the existing query plans. Turning
# off disables the query optimization but retains indexes (and their write cost).
# Standard PostgreSQL btree key-size limits apply to unusually long resource IDs.
#CLOUDLENS_READ_INDEXES=false

# What this instance calls itself in `pg_stat_activity`. Defaults to `cloudlens`.
#
# Worth setting whenever more than one instance shares a database -- a staging
# copy, a probe, a second replica. Without it every backend carries the same name
# and the view cannot say which application caused which query: profiling once
# attributed 56.5s of an endpoint to a statement a different instance was running,
# and the conclusion drawn from it was wrong.
#PG_APPLICATION_NAME=cloudlens

# Optional monthly partitions for derived dashboard, resource and billing summaries.
# Default flat preserves the existing layout. Set monthly, then explicitly run a
# full derived rebuild to migrate; boot and incremental repairs do not migrate it.
# Existing monthly tables stay partitioned if this setting later returns to flat.
# Take a database backup and allow replacement-table disk headroom before migration.
#CLOUDLENS_DERIVED_LAYOUT=monthly

# Optional native FX sufficient-statistics companion for converted cost aggregates.
# Default false. Enabling creates a new derived table and invalidates readiness;
# run a full derived rebuild on a backup/clone first. Until ready, raw conversion
# remains authoritative. No display rates are stored; rate changes need no rebuild.
# Disabling leaves the companion intact and uses the original raw conversion.
# Resource-level money and Billing's independent measures are not rerouted.
#CLOUDLENS_FX_ROLLUP=false

# Retention/storage inventory is preview-only; no automatic deletion is enabled.
# python tools\plan_retention.py --format json
# To preview keeping 12 completed calendar months plus current/future months:
# python tools\plan_retention.py --keep-months 12 --as-of 2026-09-21
# This is not an enforced retention policy; archival and deletion need a separate decision.

# ---------------------------------------------------------------- cache and diagnostics
# Durable private snapshots are kept in the configured PostgreSQL schema.
# Auth, current scope and calculation versions are checked before every cache hit.
#SNAPSHOT_CACHE_ENABLED=true
# Snapshot entries are served immediately and refreshed only when stale or explicitly
# requested. Defaults keep answers up to 24 hours and retain last-good entries for 7 days.
#SNAPSHOT_TTL_SECONDS=86400
#SNAPSHOT_RETENTION_SECONDS=604800
# A report whose evidence is partial (a throttled subscription, unverified days) is kept
# this long before a view refreshes it in the background. It never replaces a complete one.
#SNAPSHOT_PARTIAL_TTL_SECONDS=3600
# PostgreSQL storage bounds for the durable snapshot cache.
#SNAPSHOT_MAX_BYTES=268435456
#SNAPSHOT_MAX_ENTRIES=4096
#SNAPSHOT_MAX_PAYLOAD=8388608
# Seconds to wait for an explicit server-side recomputation before timing out.
#SNAPSHOT_ORIGIN_TIMEOUT=300
# Milliseconds a cache write may wait for the generation row during rebuilds.
#SNAPSHOT_LOCK_TIMEOUT_MS=2000
# Optional browser-side warming after a newer ready data generation is observed.
# Default false. Uses the signed-in browser's current authorization, keeps only
# recent report URLs in memory, and warms at most three sequential requests per
# generation per tab. Does not prewarm offline users or alter cache isolation.
#SNAPSHOT_WARMING_ENABLED=false
# ---------------------------------------------------------------- managed exports (first run)
# The installer sets this. When true, the app itself creates one Parquet FOCUS export per
# visible subscription into its own storage and backfills the current month plus the 12
# before it, newest month first; new subscriptions are onboarded on the hourly check.
# Progress: /v2/admin/setup. Needs a persistent identity (AZURE_CLIENT_ID) with Cost
# Management Contributor on each subscription (or a management group above them).
#CLOUDLENS_MANAGED_EXPORTS=false
# Azure export runs outstanding at once across all subscriptions. Throttling (429) pauses
# new runs deployment-wide and backs off exponentially under Azure's Retry-After.
#CLOUDLENS_EXPORT_CONCURRENCY=8
# Seconds between managed-export checks (minimum 60), and between retries while a check
# finds something blocked (for example role assignments still propagating after install).
#CLOUDLENS_BOOTSTRAP_INTERVAL=3600
#CLOUDLENS_BOOTSTRAP_RETRY=300
# Largest Parquet partition accepted. Azure keeps each partition under 1 GB uncompressed.
#EXPORT_MAX_PARQUET_BYTES=1073741824
# Optional workload identity metadata for permission diagnostics; these grant no access.
#CLOUDLENS_PRINCIPAL_ID=<managed identity object id, not its client id>
#CLOUDLENS_TENANT_ID=<managed identity tenant id>
# Use only on an isolated staging/restore environment. Auth remains required.
#CLOUDLENS_READ_ONLY=true

# ---------------------------------------------------------------- tests
# See tests/README.md. The suite runs against a real PostgreSQL server, so both of
# these are needed for anything but a collection-only run.
#CLOUDLENS_PG_TEST=<host>
#CLOUDLENS_PG_USER=<role to connect as>
#CLOUDLENS_PG_DB=postgres
#CLOUDLENS_AZURE_TEST=1
#CLOUDLENS_TEST_SUBSCRIPTION=<subscription with tagged resources>
