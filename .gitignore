# Local state, never committed.
data/
.env
.env.*
!.env.example
# Wherever a developer points AUTH_DATA_DIR when they would rather not write into
# `data/`. It holds `.session_secret` -- the key every session cookie is signed with
# -- and `users.json`. Being untracked is not the same as being ignored: one
# `git add -A` was all that stood between that key and the history.
.localdata/

# Screenshots from the browser-driven visual checks. Written per run, hundreds of
# kilobytes each, and meaningless once the run that produced them is over.
.shots/
# The same debris, written to the repository root by ad-hoc QA runs.
.qa-*.png

# Build and tool caches.
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
# The v3 interface is built from ui/ by `npm run build` (and by tools/package.ps1).

# Runtime output. These were being committed by accident, and a 70 KB server.err
# in a code review is noise that hides the change underneath it.
*.log
*.err

# Compiled from infra/main.bicep on demand, for Terraform environments.
infra/main.json
infra/terraform/.terraform/
infra/terraform/*.tfstate*

# Ad-hoc probe scripts written while chasing a query plan. They are notes, not code:
# they hard-code one estate's ids and stop being true the moment the data changes.
_probe_*.sql
tmp_*.py
tmp_*.log
tools/_q_*.sql
tools/resources_tab.sql

# Editor and OS leftovers.
.vscode/
.idea/
.DS_Store
Thumbs.db
